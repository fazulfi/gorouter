{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faizrr/gorouter/docs/implementation/gate-evidence/schema.json",
  "title": "Gate Evidence Schema",
  "description": "Schema for gate evidence output validating Phase 1 gates (CI, quality, security).",
  "version": "1",
  "type": "object",
  "required": [
    "phase",
    "status",
    "timestamp",
    "checks",
    "duration_seconds"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "The phase number this gate validates"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Overall gate status: pass if all checks pass, fail otherwise"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of when the gate was run"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Total duration of gate execution in seconds"
    },
    "checks": {
      "type": "array",
      "description": "Individual check results",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "output"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Check identifier (e.g. go-vet, go-test, frontend-build)"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail"],
            "description": "Check result status"
          },
          "output": {
            "type": "string",
            "description": "Check output or error message"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0,
            "description": "Duration of this individual check in seconds"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
