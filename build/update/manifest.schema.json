{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gorouter.dev/build/update/manifest.schema.json",
  "title": "GoRouter Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "platform", "checksum", "signature_url", "min_schema_version", "compat_window_days"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_url": {"type": "string", "minLength": 1},
    "min_schema_version": {"type": "integer", "minimum": 0},
    "compat_window_days": {"type": "integer", "minimum": 0}
  }
}
