# gorouter Configuration
# Precedence (highest to lowest): flags > env vars > .env file > DB settings > defaults
#
# All environment variables use the GOROUTER_ prefix.
# Corresponding flags use kebab-case: GOROUTER_LOG_LEVEL -> --log-level

# Server
# ------
# Host address to bind the HTTP server to.
# Flag: --host
# Default: 127.0.0.1
# GOROUTER_HOST=0.0.0.0

# Port to bind the HTTP server to.
# Flag: --port
# Default: 8080
# GOROUTER_PORT=8080

# Database
# --------
# PostgreSQL connection string.
# Flag: --database-url
# Format: postgres://user:password@host:5432/gorouter?sslmode=disable
# GOROUTER_DATABASE_URL=postgres://gorouter:changeme@localhost:5432/gorouter

# Logging
# -------
# Log level: trace, debug, info, warn, error
# Flag: --log-level
# Default: info
# GOROUTER_LOG_LEVEL=info

# Log output format: json, text
# Flag: --log-format
# Default: json
# GOROUTER_LOG_FORMAT=json

# Authentication
# --------------
# Dashboard admin username.
# Flag: --dashboard-user
# GOROUTER_DASHBOARD_USER=admin

# Dashboard admin password (sensitive - redacted in logs).
# Flag: --dashboard-pass
# GOROUTER_DASHBOARD_PASS=changeme

# Session signing secret (sensitive - redacted in logs).
# Flag: --session-secret
# GOROUTER_SESSION_SECRET=generate-a-random-secret-here
